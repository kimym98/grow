{
  "name": "@app/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"next dev\" \"npm run build:electron && wait-on http://localhost:3000 && cross-env NODE_ENV=development electron .\"",
    "build": "next build && npm run build:electron",
    "start": "next start",
    "lint": "eslint",
    "build:electron": "tsc -p electron/tsconfig.json --outDir dist/electron"
  },
  "build": {
    "appId": "com.grow.desktop",
    "productName": "AI 취업 비서",
    "files": [
      "dist/electron/**/*",
      "out/**/*"
    ],
    "win": {
      "target": "nsis",
      "verifyUpdateCodeSignature": false
    },
    "publish": {
      "provider": "github"
    }
  },
  "dependencies": {
    "@app/shared": "*",
    "@hookform/resolvers": "^5.9.0",
    "@supabase/supabase-js": "^2.58.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "electron-updater": "^6.8.9",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.17.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "node-schedule": "^2.1.1",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.85.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.22.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/node-schedule": "^2.1.8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9",
    "cross-env": "^7",
    "electron": "^33",
    "electron-builder": "^25",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^8"
  }
}
